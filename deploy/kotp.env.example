# Copy to /etc/kotp/kotp.env (owner root:kotp, mode 640). Never commit the real file.
DATABASE_URL=postgres://kotp:CHANGE_ME@127.0.0.1:5432/kotp
# Never change the seed once players exist: terrain and mines are generated from it.
WORLD_SEED=CHANGE_ME_TO_A_RANDOM_STRING
PORT=8080
# Only nginx should reach the game server.
HOST=127.0.0.1
