		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@types/ws": "^8.18.2",
		"drizzle-kit": "^0.31.11",
		"esbuild": "^0.28.2",
		"tsx": "^4.23.15"
	}
}
